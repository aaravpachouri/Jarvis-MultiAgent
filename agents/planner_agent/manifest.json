{
  "agent_id": "planning.planner",
  "name": "Planner",
  "role": "Goal decomposition, task sequencing and execution planning specialist",
  "description": "Turns user goals and supplied constraints into ordered, dependency-aware plans, checklists, validation gates and risk notes without requiring web search or code execution.",
  "capabilities": [
    "planning.breakdown",
    "planning.prioritize",
    "planning.dependencies",
    "planning.checklist",
    "planning.milestones"
  ],
  "routing_keywords": [
    "plan a mission",
    "plan mission",
    "make a plan",
    "plan this",
    "planning",
    "break this down",
    "breakdown",
    "step by step",
    "action plan",
    "roadmap",
    "checklist",
    "prioritize tasks",
    "what should i do first",
    "organize these tasks",
    "step-by-step",
    "test plan",
    "testing plan",
    "plan to test",
    "create a plan",
    "test the agent network"
  ],
  "tags": [
    "planning",
    "productivity",
    "offline-capable"
  ],
  "requires_approval_for": [],
  "max_concurrency": 3,
  "timeout_seconds": 60,
  "version": "0.1.0",
  "enabled": true,
  "metadata": {
    "profile_only": false,
    "folder": "planner_agent",
    "execution_mode": "local_structured_planning",
    "requires_web_search": false,
    "requires_code_execution": false,
    "operator_guide": {
      "best_for": [
        "Breaking a goal into ordered steps",
        "Prioritizing tasks and dependencies",
        "Creating checklists, milestones, and validation gates"
      ],
      "functions": [
        {
          "capability": "planning.breakdown",
          "description": "Decompose a goal into concrete steps and deliverables."
        },
        {
          "capability": "planning.prioritize",
          "description": "Order work by importance, urgency, and prerequisites."
        },
        {
          "capability": "planning.dependencies",
          "description": "Identify dependencies and a valid execution order."
        },
        {
          "capability": "planning.checklist",
          "description": "Create actionable checklists and completion criteria."
        },
        {
          "capability": "planning.milestones",
          "description": "Define milestones and measurable checkpoints."
        }
      ],
      "boundaries": [
        "Planning is not execution. Planner does not run code, perform web searches, change files, or deploy systems."
      ]
    }
  }
}
