# JARVIS model provider chain: Gemini -> Groq -> Ollama.
# Never commit your real .env or API keys.

# PRIMARY: Google Gemini OpenAI-compatible endpoint
JARVIS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JARVIS_LLM_API_KEY=YOUR_GEMINI_API_KEY
JARVIS_LLM_MODEL=gemini-2.5-flash

# SECONDARY: Groq OpenAI-compatible endpoint
# Set a currently available Groq model name from your Groq console.
JARVIS_LLM_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
JARVIS_LLM_SECONDARY_API_KEY=YOUR_GROQ_API_KEY
JARVIS_LLM_SECONDARY_MODEL=YOUR_AVAILABLE_GROQ_MODEL

# LAST RESORT: local Ollama (no API key needed for localhost)
JARVIS_LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
JARVIS_LLM_FALLBACK_API_KEY=
JARVIS_LLM_FALLBACK_MODEL=llama3.2:latest

JARVIS_LLM_TIMEOUT_SECONDS=25

# Keep any existing backend / worker environment variables from your current .env.


# JARVIS Quant market data. Keep credentials private; never paste them into chat.
# auto = use FYERS if credentials are present, otherwise use clearly-labelled Yahoo historical fallback.
JARVIS_MARKET_DATA_PROVIDER=auto
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=
# Broad quote scan limit from the FYERS NSE cash-market symbol master.
JARVIS_MARKET_SCAN_MAX_SYMBOLS=2500
# Download daily candles/indicators for the most liquid names, then 5-minute candles for leading candidates.
JARVIS_MARKET_HISTORY_SYMBOLS=50
# Minimum estimated traded turnover (last price x reported volume), in INR.
JARVIS_MARKET_MIN_TURNOVER_INR=50000000
JARVIS_MARKET_MAX_SPREAD_PCT=0.5
JARVIS_MARKET_QUOTE_BATCH_PAUSE_SECONDS=1.21
JARVIS_MARKET_HISTORY_PAUSE_SECONDS=1.21
JARVIS_MARKET_DATA_TIMEOUT=10

# Required for public hosting: set this as a secret in Render, not in source control.
# Use a long random key; the dashboard will ask for it at runtime.
JARVIS_DASHBOARD_ACCESS_KEY=SET_THIS_IN_RENDER_DASHBOARD
