{
  "agent_id": "search.scout",
  "name": "Scout",
  "role": "Fast web search and technical discovery specialist",
  "description": "Searches public web results and returns source URLs, domains, snippets, and retrieval timestamps for fast, traceable discovery.",
  "capabilities": [
    "web.search",
    "github.discover",
    "documentation.lookup",
    "api.discover",
    "package.discover"
  ],
  "routing_keywords": [
    "search the web",
    "web search",
    "search online",
    "search for",
    "google",
    "github",
    "github profile",
    "repository url",
    "find online",
    "look up",
    "package",
    "third-party service",
    "api docs",
    "latest documentation"
  ],
  "tags": [
    "retrieval",
    "web",
    "fast-path"
  ],
  "requires_approval_for": [],
  "max_concurrency": 4,
  "timeout_seconds": 20,
  "version": "0.2.0",
  "enabled": true,
  "metadata": {
    "profile_only": false,
    "folder": "search_agent",
    "provider": "Brave Search API when configured; DuckDuckGo HTML fallback",
    "endpoint_env": "JARVIS_SEARCH_ENDPOINT",
    "timeout_env": "JARVIS_SEARCH_TIMEOUT",
    "result_count_env": "JARVIS_SEARCH_RESULTS",
    "provider_env": "JARVIS_SEARCH_PROVIDER",
    "api_key_env": "BRAVE_SEARCH_API_KEY"
  }
}
