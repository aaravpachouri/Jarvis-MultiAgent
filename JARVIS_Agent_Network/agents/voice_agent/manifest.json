{
  "agent_id": "voice.jarvis",
  "name": "JARVIS",
  "role": "Main voice, chat and coordination handler",
  "description": "Primary interface for text and future speech input/output. Routes user intent to specialist agents, manages task handoffs and communicates results.",
  "capabilities": [
    "conversation.handle",
    "task.coordinate",
    "voice.input",
    "voice.output"
  ],
  "routing_keywords": [
    "jarvis",
    "talk to me",
    "voice command",
    "listen",
    "speak",
    "say this",
    "assistant",
    "coordinate task"
  ],
  "tags": [
    "core",
    "main-handler",
    "voice-chat"
  ],
  "requires_approval_for": [],
  "max_concurrency": 4,
  "timeout_seconds": 180,
  "version": "0.1.0",
  "enabled": true,
  "metadata": {
    "profile_only": false,
    "folder": "voice_agent"
  }
}
