{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jarvis-multiagent-api.onrender.com/api/:path*"
    },
    {
      "source": "/quant",
      "destination": "/quant.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
